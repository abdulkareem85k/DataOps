            </tr>
        </thead>
        <tbody>
            <tr>
                <td><strong>NIST SP 800-115</strong></td>
                <td>Target Identification, Vulnerability Scanning, Security Testing</td>
                <td>Mapped</td>
            </tr>
            <tr>
                <td><strong>OWASP Top 10:2021</strong></td>
                <td>A01 Broken Access Control, A03 Injection, A05 Security Misconfiguration</td>
                <td>Covered</td>
            </tr>
            <tr>
