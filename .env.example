# Copy to .env and replace secret placeholders before `make up`.
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_API_KEY=

# Generate both values locally with: openssl rand -hex 32
ZAP_API_KEY=
RUNNER_TOKEN=

ZAP_URL=http://zap:8090
RUNNER_URL=http://scanner-runner:9000
DB_URL=sqlite:////data/vapt.db
DATA_DIR=/data
LAB_CIDR=172.30.0.0/24

# Keep public targets and active scanning disabled unless a later approved prompt implements gates.
ALLOW_PUBLIC_TARGETS=false
ENABLE_ZAP_ACTIVE_SCAN=false
ENABLE_ACTIVE_VALIDATION=false
